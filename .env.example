# Nova backend local configuration.
NOVA_ENV=development
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
NOVA_LOG_LEVEL=INFO
NOVA_API_TOKEN=replace-with-a-local-random-value
NOVA_DATA_DIR=./data
NOVA_DATABASE_FILENAME=nova.sqlite3
NOVA_LOG_DIR=./logs
NOVA_LOG_FILENAME=nova-backend.log
NOVA_BACKUP_DIR=./backups
NOVA_BACKUP_RETENTION_COUNT=10

# Home Assistant device access. Leave these empty until Phase 3 configuration is reviewed.
# The entity allowlist is required; an empty list imports no Home Assistant entities.
NOVA_HOME_ASSISTANT_URL=
NOVA_HOME_ASSISTANT_TOKEN=
NOVA_HOME_ASSISTANT_TIMEOUT_SECONDS=10
NOVA_HOME_ASSISTANT_ALLOWED_ENTITY_IDS=["light.living_room"]
# Real device writes stay off by default; development enabling is still safety-gated.
NOVA_HOME_ASSISTANT_WRITE_ENABLED=false
NOVA_DEVICE_POLL_INTERVAL_SECONDS=30
NOVA_TOOL_CONFIRMATION_TTL_SECONDS=300
NOVA_TOOL_PERMISSIONS={"list_devices":"allow","get_environment_state":"allow","get_device_state":"allow","control_device":"allow_low_risk"}
NOVA_EVENT_RETENTION_DAYS=180
NOVA_DIAGNOSTIC_EVENT_RETENTION_DAYS=90
NOVA_LONG_TERM_EVENT_TYPES=["task_started","task_completed","task_failed","tool_executed","user_confirmed"]
NOVA_DEFAULT_ENVIRONMENT_NAME=home

# AI provider. Mock is offline by default; real calls are optional manual validation.
# Keep NOVA_AI_API_KEY only in this untracked local file or protected process environment.
NOVA_AI_PROVIDER=mock
NOVA_AI_BASE_URL=
NOVA_AI_MODEL=
NOVA_AI_API_KEY=
NOVA_AI_TIMEOUT_SECONDS=30
NOVA_AI_MAX_RETRIES=2
NOVA_AI_STRUCTURED_OUTPUT_MODE=json_schema
NOVA_AI_RETRY_BACKOFF_SECONDS=0.2

# Web console local configuration. Vite reads this file from the project root.
VITE_API_BASE_URL=http://127.0.0.1:8000
