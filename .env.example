# Arvuno backend local configuration.
ARVUNO_ENV=development
ARVUNO_HOST=127.0.0.1
ARVUNO_PORT=8000
ARVUNO_LOG_LEVEL=INFO
ARVUNO_API_TOKEN=replace-with-a-local-random-value
ARVUNO_DATA_DIR=./data
ARVUNO_DATABASE_FILENAME=arvuno.sqlite3
ARVUNO_LOG_DIR=./logs
ARVUNO_LOG_FILENAME=arvuno-backend.log
ARVUNO_BACKUP_DIR=./backups
ARVUNO_BACKUP_RETENTION_COUNT=10

# Home Assistant device access. Leave these empty until Phase 3 configuration is reviewed.
# The entity allowlist is required; an empty list imports no Home Assistant entities.
ARVUNO_HOME_ASSISTANT_URL=
ARVUNO_HOME_ASSISTANT_TOKEN=
ARVUNO_HOME_ASSISTANT_TIMEOUT_SECONDS=10
ARVUNO_HOME_ASSISTANT_ALLOWED_ENTITY_IDS=["light.living_room"]
# Real device writes stay off by default; development enabling is still safety-gated.
ARVUNO_HOME_ASSISTANT_WRITE_ENABLED=false
ARVUNO_DEVICE_POLL_INTERVAL_SECONDS=30
ARVUNO_TOOL_CONFIRMATION_TTL_SECONDS=300
ARVUNO_TOOL_PERMISSIONS={"list_devices":"allow","get_environment_state":"allow","get_device_state":"allow","control_device":"allow_low_risk"}
ARVUNO_EVENT_RETENTION_DAYS=180
ARVUNO_DIAGNOSTIC_EVENT_RETENTION_DAYS=90
ARVUNO_LONG_TERM_EVENT_TYPES=["task_started","task_completed","task_failed","tool_executed","user_confirmed"]
ARVUNO_DEFAULT_ENVIRONMENT_NAME=home

# AI provider. Mock is offline by default; real calls are optional manual validation.
# Keep ARVUNO_AI_API_KEY only in this untracked local file or protected process environment.
ARVUNO_AI_PROVIDER=mock
ARVUNO_AI_BASE_URL=
ARVUNO_AI_MODEL=
ARVUNO_AI_API_KEY=
ARVUNO_AI_TIMEOUT_SECONDS=30
ARVUNO_AI_MAX_RETRIES=2
ARVUNO_AI_STRUCTURED_OUTPUT_MODE=json_schema
ARVUNO_AI_RETRY_BACKOFF_SECONDS=0.2

# Web console local configuration. Vite reads this file from the project root.
VITE_API_BASE_URL=http://127.0.0.1:8000
