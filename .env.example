# Nova backend local configuration.
NOVA_ENV=development
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
NOVA_LOG_LEVEL=INFO
NOVA_API_TOKEN=replace-with-a-local-random-value
NOVA_DATA_DIR=./data
NOVA_DATABASE_FILENAME=nova.sqlite3
NOVA_LOG_DIR=./logs
NOVA_LOG_FILENAME=nova-backend.log
NOVA_BACKUP_DIR=./backups
NOVA_BACKUP_RETENTION_COUNT=10

# Home Assistant device access. Leave these empty until Phase 3 configuration is reviewed.
# The entity allowlist is required; an empty list imports no Home Assistant entities.
NOVA_HOME_ASSISTANT_URL=
NOVA_HOME_ASSISTANT_TOKEN=
NOVA_HOME_ASSISTANT_TIMEOUT_SECONDS=10
NOVA_HOME_ASSISTANT_ALLOWED_ENTITY_IDS=["light.living_room"]
# Real device writes stay off until the Safety Policy and Tool Executor are complete.
NOVA_HOME_ASSISTANT_WRITE_ENABLED=false
NOVA_DEVICE_POLL_INTERVAL_SECONDS=30

# Web console local configuration. Vite reads this file from the project root.
VITE_API_BASE_URL=http://127.0.0.1:8000
